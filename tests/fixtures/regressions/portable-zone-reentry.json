    "path": [
      { "path": { "x": 5, "y": 5, "width": 1, "height": 1 } },
      { "path": { "x": 5, "y": 6, "width": 1, "height": 1 } },
      { "path": { "x": 7, "y": 6, "width": 1, "height": 1 } },
      { "path": { "x": 6, "y": 5, "width": 1, "height": 1 } },
      { "path": { "x": 6, "y": 6, "width": 1, "height": 1 } }
    ]
  },
  "assert": { "entryIndices": [0, 3], "uses": 2 }
